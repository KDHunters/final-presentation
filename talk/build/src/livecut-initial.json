from":6528,"n":86,"delay":11},{"key":"gmailSaved","chapter":5,"from":6614,"n":79,"delay":0},{"key":"chatAsk","chapter":5,"from":6693,"n":147,"delay":0},{"key":"chatAgree","chapter":5,"from":6840,"n":104,"delay":0},{"key":"chatPrompt","chapter":5,"from":6944,"n":244,"delay":0},{"key":"recallAsk","chapter":5,"from":7188,"n":98,"delay":0},{"key":"recallWait","chapter":5,"from":7286,"n":132,"delay":0},{"key":"recallPrompt","chapter":5,"from":7418,"n":120,"delay":0},{"key":"recallReply","chapter":5,"from":7538,"n":245,"delay":0},{"key":"friend","chapter":5,"from":7783,"n":322,"delay":0},{"key":"back","chapter":6,"from":8105,"n":14,"delay":0},{"key":"countries","chapter":6,"from":8119,"n":24,"delay":0},{"key":"reach","chapter":6,"from":8143,"n":153,"delay":0},{"key":"week","chapter":6,"from":8296,"n":132,"delay":0},{"key":"retention","chapter":6,"from":8428,"n":345,"delay":0},{"key":"feedback","chapter":7,"from":8773,"n":453,"delay":0},{"key":"mailbox","chapter":7,"from":9226,"n":222,"delay":0},{"key":"letterKR","chapter":7,"from":9448,"n":172,"delay":0},{"key":"letterBR","chapter":7,"from":9620,"n":178,"delay":0},{"key":"heavy","chapter":7,"from":9798,"n":264,"delay":0},{"key":"personalEnd","chapter":7,"from":10062,"n":342,"delay":0},{"key":"handoff","chapter":7,"from":10404,"n":230,"delay":0}],"cues":[{"kind":"say","text":"안녕하십니까, ADHD가 있는 분들을 위한 메모 앱","from":0,"n":84,"old":0,"oldN":114},{"kind":"say","text":"스티키펫을 만든 조현석, 김서영, 박도현입니다.","from":84,"n":89,"old":114,"oldN":91},{"kind":"say","text":"발표에 앞서 한 가지 말씀드리고 싶습니다.","from":173,"n":63,"old":0,"oldN":85},{"kind":"wait","text":"청중을 보고 한 박자 쉰다","from":236,"n":24,"old":85,"oldN":24},{"kind":"say","text":"저는 올해 ADHD 진단을 받았습니다.","from":260,"n":72,"old":109,"oldN":95},{"kind":"say","text":"프로젝트가 끝나도 제가 계속 쓸 앱을 만들고 싶었습니다.","from":332,"n":93,"old":204,"oldN":112},{"kind":"say","text":"저처럼 자주 깜빡하는 분들께도 도움이 되길 바랐습니다.","from":425,"n":92,"old":316,"oldN":113},{"kind":"say","text":"저희가 만난 한 분의 이야기입니다.","from":517,"n":55,"old":429,"oldN":71},{"kind":"clip","text":"","from":572,"n":281,"old":0,"oldN":281},{"kind":"say","text":"저도 뭘 적으려고 휴대폰을 들었다가, 화면을 켜고","from":853,"n":69,"old":0,"oldN":95},{"kind":"say","text":"나면 ‘내가 뭘 적으려고 했지?’ 할 때가 있습니다.","from":922,"n":67,"old":95,"oldN":86},{"kind":"say","text":"휴대폰을 꺼내서 메모를 열 때까지 적을 내용을 잠깐","from":989,"n":74,"old":181,"oldN":100},{"kind":"say","text":"머릿속에 담아 둬야 합니다. 그때 쓰는 게 작업 기억입니다.","from":1063,"n":87,"old":281,"oldN":109},{"kind":"say","text":"저는 휴대폰을 꺼내는 그 몇 초 사이에도","from":1150,"n":46,"old":390,"oldN":77},{"kind":"say","text":"생각이 사라질 때가 있습니다.","from":1196,"n":52,"old":467,"oldN":59},{"kind":"say","text":"잊어버린 걸 나중에 떠올려도 이미 늦을 때가 있습니다.","from":1248,"n":71,"old":0,"oldN":106},{"kind":"say","text":"가령 구독을 해지하려던 날을 놓치면 다음 달 요금이 또 나갑니다.","from":1319,"n":87,"old":106,"oldN":123},{"kind":"say","text":"이렇게 더 드는 돈을 ‘ADHD 택스’라고 부르기도 합니다.","from":1406,"n":77,"old":229,"oldN":124},{"kind":"say","text":"저희 설문에서는 절반 넘는 분이 이런 이유로","from":1483,"n":68,"old":353,"oldN":86},{"kind":"say","text":"한 달에 10만 원 이상을 더 쓴다고 답했습니다.","from":1551,"n":52,"old":439,"oldN":87},{"kind":"say","text":"그러면 ‘그냥 메모해두면 되지 않나?’","from":1603,"n":68,"old":0,"oldN":83},{"kind":"say","text":"하는 생각이 드실 수 있습니다.","from":1671,"n":40,"old":83,"oldN":71},{"kind":"wait","text":"청중을 본다","from":1711,"n":22,"old":154,"oldN":22},{"kind":"say","text":"저도 그래서 메모 앱을 여러 개 써봤습니다.","from":1733,"n":54,"old":0,"oldN":82},{"kind":"say","text":"그런데 적을 게 생각나면, 메모 앱을","from":1787,"n":53,"old":82,"oldN":68},{"kind":"say","text":"열어야 한다는 것부터 기억해야 했습니다.","from":1840,"n":50,"old":150,"oldN":82},{"kind":"say","text":"앱을 찾아서 열고 나면 거기에 뭘 쓰려고","from":1890,"n":49,"old":232,"oldN":77},{"kind":"say","text":"했는지 잊어버릴 때가 있었습니다.","from":1939,"n":52,"old":309,"oldN":68},{"kind":"say","text":"잊기 전에 적어 놓은 날도 있었습니다. 그런데 앱을 닫고 나면","from":1991,"n":86,"old":0,"oldN":114},{"kind":"say","text":"적어 놨다는 사실까지 잊어서 다시 열어볼 생각을 못 했습니다.","from":2077,"n":77,"old":114,"oldN":119},{"kind":"say","text":"저희가 인터뷰한 분들도 비슷한 얘기를 하셨습니다.","from":2154,"n":65,"old":233,"oldN":100},{"kind":"say","text":"그래서 이렇게 생각했습니다.","from":2219,"n":48,"old":0,"oldN":63},{"kind":"say","text":"‘눈앞에 없으면 잊는데, 처음부터 눈앞에 있으면 어떨까?’","from":2267,"n":85,"old":63,"oldN":113},{"kind":"say","text":"그렇다고 메모장이 하루 종일 화면을","from":2352,"n":43,"old":0,"oldN":72},{"kind":"say","text":"가리면 저부터 꺼버릴 것 같았습니다.","from":2395,"n":56,"old":72,"oldN":72},{"kind":"say","text":"혼자서는 미루던 일도 누가 옆에서 자기 일을","from":2451,"n":61,"old":144,"oldN":86},{"kind":"say","text":"하고 있으면 저도 시작할 때가 있습니다.","from":2512,"n":63,"old":230,"oldN":77},{"kind":"say","text":"이렇게 누군가와 함께 각자 할 일을","from":2575,"n":36,"old":307,"oldN":68},{"kind":"say","text":"하는 걸 ‘바디 더블링’이라고 합니다.","from":2611,"n":44,"old":375,"oldN":68},{"kind":"say","text":"저희는 여기서 힌트를 얻었습니다. 메모장을 계속 띄워 놓는 대신","from":2655,"n":95,"old":443,"oldN":123},{"kind":"say","text":"작은 강아지를 곁에 두고, 필요할 때만 메모를 열게 했습니다.","from":2750,"n":85,"old":566,"oldN":114},{"kind":"say","text":"제가 먼저 제 폰에 띄워 써보고, 다른 분들이 써보면서","from":2835,"n":63,"old":680,"oldN":100},{"kind":"say","text":"해주신 얘기를 듣고 고쳤습니다. 직접 보여드리겠습니다.","from":2898,"n":76,"old":780,"oldN":109},{"kind":"say","text":"여기가 스티키펫의 첫 화면입니다. 저희는 마당이라고 부릅니다.","from":2974,"n":88,"old":0,"oldN":123},{"kind":"say","text":"여기서 강아지랑 놀 수도 있고,","from":3062,"n":52,"old":123,"oldN":59},{"kind":"say","text":"아래쪽에 보이는 메모장을 열 수도 있습니다.","from":3114,"n":54,"old":182,"oldN":86},{"kind":"say","text":"여기를 누르면 제가 적어 놓은 메모가 나옵니다.","n":62,"from":3168},{"kind":"say","text":"여기까지만 보면 강아지 키우는 앱에","n":52,"from":3230},{"kind":"say","text":"메모장 하나 붙인 것 같습니다.","n":44,"from":3282},{"kind":"say","text":"앱을 나가보겠습니다.","n":33,"from":3326},{"kind":"wait","text":"앱 밖으로 · 손을 뗀다","from":3359,"n":32,"old":0,"oldN":32},{"kind":"wait","text":"강아지가 보일 때까지 기다린다","from":3391,"n":43,"old":0,"oldN":43},{"kind":"say","text":"저는 앱을 나왔는데, 아까 마당에 있던 강아지는 따라 나왔습니다.","from":3434,"n":92,"old":43,"oldN":123},{"kind":"say","text":"이제 다른 걸 하다가 적을 게 생기면 메모","from":3526,"n":54,"old":166,"oldN":78},{"kind":"say","text":"앱을 찾지 않고 이 친구를 누르면 됩니다.","from":3580,"n":53,"old":244,"oldN":77},{"kind":"wait","text":"펫 누르기","from":3633,"n":26,"old":0,"oldN":26},{"kind":"hold","from":3659,"n":54,"text":""},{"kind":"say","text":"저녁에 장을 봐야 하면 ‘우유, 달걀’만 적으면 됩니다.","from":3713,"n":88,"old":0,"oldN":95},{"kind":"say","text":"이걸 어느 목록에 넣을지,","from":3801,"n":35,"old":95,"oldN":49},{"kind":"say","text":"날짜는 언제로 할지 먼저 정하지 않아도 됩니다.","from":3836,"n":62,"old":144,"oldN":91},{"kind":"say","text":"저는 생각났을 때 적는 게 먼저였으면 했습니다.","from":3898,"n":71,"old":235,"oldN":91},{"kind":"say","text":"여기까지 보신 마당과 기본 메모는 이미 출시했습니다.","n":72,"from":3969},{"kind":"say","text":"이제 같은 폰에서 시험 중인 기능을 보여드리겠습니다.","n":74,"from":4041},{"kind":"say","text":"할 일이 여러 개인데 하나씩 타자로 치려면","n":52,"from":4115},{"kind":"say","text":"번거롭습니다. 이번엔 생각나는 대로 말해보겠습니다.","n":69,"from":4167},{"kind":"say","text":"내일 세 시에 치과 가고, 집에 오는 길에 세탁물 찾아야지.","from":4236,"n":80,"old":0,"oldN":127},{"kind":"say","text":"아, 서영이한테 자료도 보내야 돼.","from":4316,"n":45,"old":127,"oldN":81},{"kind":"hold","from":4361,"n":93,"text":""},{"kind":"say","text":"방금 저는 할 일을 세 가지 말했습니다.","from":4454,"n":61,"old":0,"oldN":72},{"kind":"say","text":"제목을 붙이거나 순서를 정해서 말하지는 않았습니다.","from":4515,"n":67,"old":72,"oldN":105},{"kind":"wait","text":"결과가 뜰 때까지 기다린다","from":4582,"n":29,"old":177,"oldN":29},{"kind":"say","text":"치과는 내일 세 시 일정으로, 세탁물 찾기와","from":4611,"n":68,"old":0,"oldN":82},{"kind":"say","text":"서영이한테 자료 보내기는 각각 할 일로 들어갔습니다.","from":4679,"n":67,"old":82,"oldN":105},{"kind":"say","text":"그런데 지하철에서 청첩장을 받았다고 해보겠습니다.","from":4746,"n":73,"old":0,"oldN":105},{"kind":"say","text":"옆에 사람들이 있는데 예식 날짜와","from":4819,"n":49,"old":105,"oldN":68},{"kind":"say","text":"장소를 소리 내서 읽기는 좀 그렇습니다.","from":4868,"n":46,"old":173,"oldN":77},{"kind":"say","text":"이럴 땐 청첩장을 연 채로 화면을 캡처합니다.","from":4914,"n":71,"old":250,"oldN":86},{"kind":"wait","text":"캡처하고 기다린다","from":4985,"n":58,"old":0,"oldN":58},{"kind":"hold","from":5043,"n":6,"text":""},{"kind":"say","text":"예식 날짜와 시간, 장소가 한 번에 메모에 들어왔습니다.","n":83,"from":5049},{"kind":"hold","from":5132,"n":1,"text":""},{"kind":"say","text":"메모를 적는 것만큼 다시 찾는 것도 중요합니다.","from":5133,"n":60,"old":0,"oldN":91},{"kind":"say","text":"아까 저는 ‘치과’라고 했는데, 나중에는","from":5193,"n":58,"old":91,"oldN":72},{"kind":"say","text":"‘병원 언제 가더라?’만 생각날 수 있습니다.","from":5251,"n":52,"old":163,"oldN":77},{"kind":"say","text":"이번에는 병원으로 찾아보겠습니다.","from":5303,"n":47,"old":240,"oldN":72},{"kind":"wait","text":"검색 결과를 보여준다","from":5350,"n":24,"old":0,"oldN":24},{"kind":"say","text":"‘병원’이라고 쳤는데 아까 말한 치과 예약이 나옵니다.","from":5374,"n":68,"old":24,"oldN":107},{"kind":"say","text":"제가 적을 때 어떤 단어를 썼는지까지 기억하지 않아도 됩니다.","from":5442,"n":78,"old":131,"oldN":126},{"kind":"say","text":"지금까지는 제가 ‘이거 적어야겠다’고","from":5520,"n":56,"old":0,"oldN":72},{"kind":"say","text":"생각하고 먼저 강아지를 눌렀습니다.","from":5576,"n":53,"old":72,"oldN":72},{"kind":"say","text":"그런데 저는 적어야 한다는 생각도 못 하고 지나칠 때가 있습니다.","from":5629,"n":84,"old":144,"oldN":123},{"kind":"say","text":"강아지는 그때도 제 화면에 떠 있습니다.","from":5713,"n":53,"old":267,"oldN":77},{"kind":"say","text":"제가 누르기 전에 먼저 적어둘지 물어보면 어떨까 싶었습니다.","from":5766,"n":83,"old":344,"oldN":119},{"kind":"say","text":"그래서 강아지가 먼저 물어보는 자동 추천을","n":60,"from":5849},{"kind":"say","text":"만들어 봤습니다. 아직 출시 전입니다.","n":56,"from":5909},{"kind":"wait","text":"자동 추천 켜기","from":5965,"n":41,"old":0,"oldN":41},{"kind":"say","text":"저는 서울에 갈 때 버스나 KTX 표를 자주 끊습니다.","from":6006,"n":73,"old":0,"oldN":109},{"kind":"say","text":"여기 서울행 KTX 표를 하나 준비했습니다.","from":6079,"n":60,"old":109,"oldN":95},{"kind":"say","text":"예매는 했지만 출발 시간은 또 따로 챙겨야 합니다.","from":6139,"n":75,"old":204,"oldN":95},{"kind":"say","text":"메모를 열지도 않았는데 강아지가 먼저 아홉 시 이십","from":6214,"n":63,"old":0,"oldN":100},{"kind":"say","text":"분 열차를 적어둘지 물어봅니다. 저장해보겠습니다.","from":6277,"n":83,"old":100,"oldN":100},{"kind":"wait","text":"저장된 출발 시간 확인","from":6360,"n":38,"old":0,"oldN":38},{"kind":"hold","from":6398,"n":57,"text":""},{"kind":"say","text":"이번에는 시연용으로 준비한 발표 공지 메일입니다.","from":6455,"n":73,"old":0,"oldN":100},{"kind":"say","text":"발표는 금요일 오후 두 시입니다. 이 시간만 저장해 두겠습니다.","from":6528,"n":86,"old":0,"oldN":119},{"kind":"wait","text":"저장 완료","from":6614,"n":24,"old":0,"oldN":24},{"kind":"hold","from":6638,"n":55,"text":""},{"kind":"say","text":"이번엔 친구가 카톡으로 저녁을 먹자고 합니다.","from":6693,"n":68,"old":0,"oldN":91},{"kind":"say","text":"제가 ‘좋아’라고 답해보겠습니다.","from":6761,"n":40,"old":91,"oldN":63},{"kind":"hold","from":6801,"n":39,"text":""},{"kind":"wait","text":"좋아 · 전송","from":6840,"n":29,"old":0,"oldN":29},{"kind":"hold","from":6869,"n":75,"text":""},{"kind":"say","text":"제가 답장을 보내고 나니까, 강아지가 금요일","from":6944,"n":59,"old":0,"oldN":86},{"kind":"say","text":"저녁 여섯 시 약속을 적어둘지 물어봅니다.","from":7003,"n":59,"old":86,"oldN":82},{"kind":"hold","from":7062,"n":126,"text":""},{"kind":"say","text":"이번엔 같은 대화방에서 이런 질문이 왔습니다.","n":66,"from":7188},{"kind":"say","text":"‘우리 발표 몇 시였지?’","n":32,"from":7254},{"kind":"say","text":"평소라면 여기서 카톡을 나가서 아까","from":7286,"n":55,"old":0,"oldN":72},{"kind":"say","text":"그 메일을 찾아보고 돌아왔을 겁니다.","from":7341,"n":46,"old":72,"oldN":72},{"kind":"wait","text":"펫이 먼저 시간을 꺼낼 때까지","from":7387,"n":31,"old":144,"oldN":31},{"kind":"say","text":"금요일 두 시입니다. 아까 제가 메일을 보면서","from":7418,"n":61,"old":0,"oldN":86},{"kind":"say","text":"저장한 발표 시간이 카톡에 바로 떴습니다.","from":7479,"n":59,"old":86,"oldN":82},{"kind":"wait","n":36,"text":"‘금요일 두 시야’라고 직접 답장을 보낸다","from":7538},{"kind":"hold","from":7574,"n":209,"text":""},{"kind":"say","text":"처음 마당에서 보셨을 때는 그냥 귀여운 강아지 한 마리였습니다.","from":7783,"n":84,"old":0,"oldN":123},{"kind":"say","text":"그런데 방금은 제가 발표 시간을 잊어도 이 친구가","from":7867,"n":66,"old":123,"oldN":95},{"kind":"say","text":"기억하고 있어서, 메일을 다시 찾지 않아도 됐습니다.","from":7933,"n":80,"old":218,"oldN":100},{"kind":"say","text":"저희가 만들고 싶은 건 필요할 때","from":8013,"n":36,"old":318,"oldN":63},{"kind":"say","text":"이렇게 옆에서 알려주는 친구입니다.","from":8049,"n":56,"old":381,"oldN":72},{"kind":"wait","n":14,"text":"출시한 앱의 성과 화면으로 전환한다","from":8105},{"kind":"wait","n":24,"text":"화면에만 표시: 구글 플레이 배포 국가·지역 22곳","from":8119},{"kind":"say","text":"구글 플레이 콘솔 기준으로, 11월 24일까지","n":72,"from":8143},{"kind":"say","text":"스티키펫을 처음 설치한 분은 7,663명입니다.","n":81,"from":8215},{"kind":"say","text":"저희는 처음 쓴 분들이 일주일 뒤에도 메모가","n":64,"from":8296},{"kind":"say","text":"필요할 때 이 강아지를 다시 찾는지 궁금했습니다.","n":68,"from":8360},{"kind":"say","text":"그래서 앱 사용 기록을 따로 봤습니다.","n":57,"from":8428},{"kind":"say","text":"처음 쓴 날에서 딱 일주일","n":38,"from":8485},{"kind":"say","text":"뒤에 앱을 다시 열거나 메모를","n":40,"from":8523},{"kind":"say","text":"보거나 고친 경우만 셌습니다.","n":54,"from":8563},{"kind":"say","text":"강아지가 화면에 떠 있기만 한 경우는","n":44,"from":8617},{"kind":"say","text":"뺐습니다. 설치 기준으로 23.5%였습니다.","n":69,"from":8661},{"kind":"wait","n":43,"text":"숫자를 보여주고 한 박자 쉰다","from":8730},{"kind":"say","text":"그런데 사용 기록만 봐서는 사람들이","from":8773,"n":49,"old":0,"oldN":72},{"kind":"say","text":"왜 다시 왔는지까지는 알 수 없습니다.","from":8822,"n":55,"old":72,"oldN":72},{"kind":"say","text":"중간평가 때 이런 말씀을 들었습니다. ADHD가 아니어도 평소에 잘","from":8877,"n":104,"old":144,"oldN":146},{"kind":"say","text":"잊어버리는 분이라면 이 앱이 필요하지 않겠냐는 말씀이었습니다.","from":8981,"n":84,"old":290,"oldN":128},{"kind":"say","text":"저희는 광고에서 ADHD를 앞세우지 않았습니다. 그래서 어떤","from":9065,"n":91,"old":418,"oldN":137},{"kind":"say","text":"분들이 스티키펫을 찾아왔는지 직접 여쭤보고 싶었습니다.","from":9156,"n":70,"old":555,"oldN":114},{"kind":"say","text":"그래서 앱 안 우편함으로 저희가 먼저 편지를 보냈습니다.","from":9226,"n":86,"old":0,"oldN":117},{"kind":"say","text":"평소에 스티키펫을 어떻게 쓰고 계신지 여쭤봤습니다.","from":9312,"n":81,"old":117,"oldN":112},{"kind":"say","text":"그렇게 받은 답장이 300건 정도였습니다.","from":9393,"n":55,"old":229,"oldN":88},{"kind":"wait","text":"답장 한 통을 읽는 시간","from":9448,"n":55,"old":0,"oldN":55},{"kind":"say","text":"이분은 평소에 자주 깜빡해서 스티키펫을","from":9503,"n":64,"old":55,"oldN":82},{"kind":"say","text":"한번 써보려고 한다고 적어주셨습니다.","from":9567,"n":53,"old":137,"oldN":77},{"kind":"say","text":"브라질에서 답장을 주신 분은 심리교육 일을 하신다고 합니다.","from":9620,"n":83,"old":0,"oldN":119},{"kind":"say","text":"본인뿐 아니라 그 일로 만나는 분들께도","from":9703,"n":51,"old":119,"oldN":77},{"kind":"say","text":"도움이 됐다고 적어주셨습니다.","from":9754,"n":44,"old":196,"oldN":63},{"kind":"say","text":"답장에 본인이 ADHD라고 직접 적어주신","from":9798,"n":66,"old":0,"oldN":100},{"kind":"say","text":"분도 스물여섯 분 있었습니다.","from":9864,"n":37,"old":100,"oldN":59},{"kind":"say","text":"그분들이 스티키펫을 얼마나 쓰는지 따로 봤더니,","from":9901,"n":71,"old":159,"oldN":95},{"kind":"say","text":"스물여섯 분 중 열두 분이 사용량 상위 10%에 들었습니다.","from":9972,"n":90,"old":254,"oldN":119},{"kind":"say","text":"처음에 저는 제가 계속 쓸 앱을 만들고 싶었다고 말씀드렸습니다.","from":10062,"n":83,"old":0,"oldN":147},{"kind":"say","text":"저는 이제 메모를 어디에 적어 뒀는지","from":10145,"n":48,"old":147,"oldN":82},{"kind":"say","text":"찾아다니던 때로 돌아가고 싶지 않습니다.","from":10193,"n":53,"old":229,"oldN":101},{"kind":"say","text":"그런데 우편함을 열어보니 저처럼 자꾸 깜빡해서 이 앱을","from":10246,"n":80,"old":330,"oldN":123},{"kind":"say","text":"찾아온 분들이 계셨습니다. 저는 그게 참 반가웠습니다.","from":10326,"n":78,"old":453,"oldN":126},{"kind":"say","text":"이제 저희 팀장 김서영 님께 마이크를 넘기겠습니다.","from":10404,"n":170,"old":0,"oldN":145},{"kind":"wait","text":"서영님에게 마이크를 넘긴다","from":10574,"n":60,"old":145,"oldN":60}],"chapters":[{"title":"시작 인사","from":0,"n":572},{"title":"놓치는 순간","from":572,"n":1031},{"title":"눈앞에 두는 이유","from":1603,"n":1371},{"title":"앱 밖으로","from":2974,"n":995},{"title":"말하고, 찍고, 다시 찾기","from":3969,"n":1551},{"title":"같은 폰의 시제품","from":5520,"n":2585},{"title":"출시 후 일주일","from":8105,"n":668},{"title":"답장이 알려준 것","from":8773,"n":1861}]}