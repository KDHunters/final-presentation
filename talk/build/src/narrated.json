{"fps":24,"total":13474,"chapters":[{"n":625,"title":"시작 인사","from":0},{"n":1215,"title":"놓치는 순간","from":625},{"n":1810,"title":"눈앞에 두는 이유","from":1840},{"n":1357,"title":"앱 밖으로","from":3650},{"n":2026,"title":"말하고, 찍고, 다시 찾기","from":5007},{"n":2873,"title":"같은 폰의 시제품","from":7033},{"n":1297,"title":"출시 후 일주일","from":9906},{"n":2271,"title":"답장이 알려준 것","from":11203}],"views":[{"key":"cover","action":"청중을 보고 인사한다. 휴대폰은 아직 들지 않는다.","chapter":0,"from":0,"n":186},{"key":"personal","action":"표지는 그대로 둔다. 화면을 보지 않고 청중에게 이야기한다.","chapter":0,"from":186,"n":439},{"key":"interview","action":"발표자는 말하지 않고 팀의 인터뷰 원음을 들려준다.","chapter":1,"from":625,"n":281},{"key":"flash","action":"소리가 끝나면 청중을 본다.","chapter":1,"from":906,"n":487},{"key":"tax","action":"그래프에서 강조된 한 조각만 짚는다.","chapter":1,"from":1393,"n":447},{"key":"question","action":"그래프는 그대로 두고 청중에게 질문한 뒤 한 박자 기다린다.","chapter":2,"from":1840,"n":147},{"key":"lost","action":"원본 답장을 보여주고, 앱을 찾는 사이 잊었다는 구절을 짚는다.","chapter":2,"from":1987,"n":361},{"key":"forgot","action":"화면은 넘기지 않고 두 번째 답장의 강조 구절을 가리킨다.","chapter":2,"from":2348,"n":318},{"key":"visible","action":"뒤의 답장을 흐리게 하고 질문 하나만 남긴다.","chapter":2,"from":2666,"n":158},{"key":"beside","action":"강아지 하나만 남긴다.","chapter":2,"from":2824,"n":826},{"key":"yard","action":"마당을 열고 강아지를 한 번 누른다.","chapter":3,"from":3650,"n":242},{"key":"insideMemo","action":"마당 아래쪽 메모를 연다.","chapter":3,"from":3892,"n":372},{"key":"homeEmpty","action":"홈으로 나가고 손을 뗀다.","chapter":3,"from":4264,"n":32},{"key":"homePet","action":"펫이 나타난 뒤에 가리킨다.","chapter":3,"from":4296,"n":389},{"key":"quick","action":"펫을 한 번 눌러 빠른 메모를 연다.","chapter":3,"from":4685,"n":26},{"key":"shopping","action":"‘우유, 달걀’을 적고 장보기 목록 탭을 잠깐 보여준다.","chapter":3,"from":4711,"n":296},{"key":"voiceReady","action":"마이크 버튼을 누른다.","chapter":4,"from":5007,"n":390},{"key":"voiceListen","action":"마이크가 켜진 상태. 이 대사만 휴대폰에 말한다.","chapter":4,"from":5397,"n":172},{"key":"voiceWait","action":"녹음을 끝낸다. 처리되는 동안 대사 한 줄로 기다린다.","chapter":4,"from":5569,"n":193},{"key":"voiceResult","action":"입력된 할 일 중 치과를 짚는다. 나중에 검색으로 회수한다.","chapter":4,"from":5762,"n":184},{"key":"invite","action":"시연용 청첩장을 연다.","chapter":4,"from":5946,"n":365},{"key":"captureWait","action":"캡처를 눌러 예식 일정 추출을 기다린다.","chapter":4,"from":6311,"n":48},{"key":"captureResult","action":"추출된 예식 일정을 저장한다.","chapter":4,"from":6359,"n":111},{"key":"searchType","action":"검색창에 치과가 아니라 ‘병원’을 입력한다.","chapter":4,"from":6470,"n":327},{"key":"searchResult","action":"‘치과’ 메모가 뜨면 손을 뗀다.","chapter":4,"from":6797,"n":236},{"key":"boundary","action":"휴대폰에서 손을 떼고 출시판과 시제품의 경계를 말한다.","chapter":5,"from":7033,"n":422},{"key":"proto","action":"같은 폰을 유지한다. 여기서부터 ‘시제품’ 표시를 유지한다.","chapter":5,"from":7455,"n":277},{"key":"autoOn","action":"시연용 자동 추천을 켠다.","chapter":5,"from":7732,"n":41},{"key":"ticket","action":"가상의 서울행 표를 열고 손을 뗀다.","chapter":5,"from":7773,"n":303},{"key":"ticketPrompt","action":"펫이 시간을 제안하면 저장을 누른다.","chapter":5,"from":8076,"n":206},{"key":"ticketSaved","action":"저장된 출발 시간을 한 번만 확인한다.","chapter":5,"from":8282,"n":38},{"key":"gmail","action":"Gmail의 시연용 발표 공지에서 금요일 오후 두 시를 보여준다.","chapter":5,"from":8320,"n":95},{"key":"gmailPrompt","action":"펫의 제안을 한 번 눌러 저장한다.","chapter":5,"from":8415,"n":127},{"key":"gmailSaved","action":"저장 확인 뒤 바로 채팅으로 전환한다.","chapter":5,"from":8542,"n":24},{"key":"chatAsk","action":"친구와의 시연용 약속방을 연다.","chapter":5,"from":8566,"n":151},{"key":"chatAgree","action":"‘좋아’를 직접 보낸다.","chapter":5,"from":8717,"n":29},{"key":"chatPrompt","action":"약속이 성립한 뒤 뜨는 제안을 한 번 누른다.","chapter":5,"from":8746,"n":159},{"key":"recallAsk","action":"별도의 팀 시연방으로 간다. Gmail로 돌아가지 않는다.","chapter":5,"from":8905,"n":130},{"key":"recallWait","action":"폰에서 손을 뗀 채 기다린다. 정답은 미리 말하지 않는다.","chapter":5,"from":9035,"n":165},{"key":"recallPrompt","action":"메일에서 저장한 시간이 뜬 뒤에만 읽는다.","chapter":5,"from":9200,"n":159},{"key":"recallReply","action":"제안을 보고 ‘금요일 두 시야’라고 직접 답한다.","chapter":5,"from":9359,"n":111},{"key":"friend","action":"시제품의 강아지 하나로 돌아온다.","chapter":5,"from":9470,"n":436},{"key":"back","action":"폰을 내려놓고 출시판 이야기로 돌아간다.","chapter":6,"from":9906,"n":203},{"key":"countries","action":"출시 범위만 보여준다.","chapter":6,"from":10109,"n":133},{"key":"reach","action":"누적 사용자 수로 바꾼다. 설치 횟수와 혼동하지 않는다.","chapter":6,"from":10242,"n":157},{"key":"week","action":"누적 사용자 수 화면을 그대로 두고 청중에게 질문한다.","chapter":6,"from":10399,"n":377},{"key":"retention","action":"정확히 7일째 앱·메모를 직접 쓴 값만 표시한다.","chapter":6,"from":10776,"n":427},{"key":"feedback","action":"원본 중간평가 의견 중 대상 확대 내용에만 초점을 둔다.","chapter":7,"from":11203,"n":632},{"key":"mailbox","action":"우편함에서 받은 답장 규모를 한 번만 보여준다.","chapter":7,"from":11835,"n":281},{"key":"letterKR","action":"이름 없는 실제 한국어 답장. 읽을 시간을 준다.","chapter":7,"from":12116,"n":197},{"key":"letterBR","action":"브라질 응답은 직접 인용이 아니라 답장 요지로 보여준다.","chapter":7,"from":12313,"n":240},{"key":"heavy","action":"자발적으로 밝힌 응답자에 한정해 설명한다.","chapter":7,"from":12553,"n":335},{"key":"personalEnd","action":"강아지만 남기고 청중을 본다.","chapter":7,"from":12888,"n":455},{"key":"handoff","action":"서영님 쪽을 보고 마이크를 넘긴다. 뒷부분은 재생하지 않는다.","chapter":7,"from":13343,"n":131}],"cues":[{"from":0,"n":77,"old":0,"oldN":114,"kind":"say","text":"안녕하십니까, ADHD가 있는 분들을 위한 메모 앱"},{"from":77,"n":109,"old":114,"oldN":91,"kind":"say","text":"스티키펫을 만든 조현석, 김서영, 박도현입니다."},{"from":186,"n":76,"old":205,"oldN":85,"kind":"say","text":"발표에 앞서 한 가지 말씀드리고 싶습니다."},{"from":262,"n":22,"old":290,"oldN":24,"kind":"wait","text":"청중을 보고 한 박자 쉰다"},{"from":284,"n":79,"old":314,"oldN":95,"kind":"say","text":"저는 올해 ADHD 진단을 받았습니다."},{"from":363,"n":96,"old":409,"oldN":112,"kind":"say","text":"프로젝트가 끝나도 제가 계속 쓸 앱을 만들고 싶었습니다."},{"from":459,"n":96,"old":521,"oldN":113,"kind":"say","text":"저처럼 자주 깜빡하는 분들께도 도움이 되길 바랐습니다."},{"from":555,"n":70,"old":634,"oldN":71,"kind":"say","text":"저희가 만난 한 분의 이야기입니다."},{"from":625,"n":281,"old":705,"oldN":281,"kind":"clip","text":""},{"from":906,"n":80,"old":986,"oldN":95,"kind":"say","text":"저도 뭘 적으려고 휴대폰을 들었다가, 화면을 켜고"},{"from":986,"n":88,"old":1081,"oldN":86,"kind":"say","text":"나면 ‘내가 뭘 적으려고 했지?’ 할 때가 있습니다."},{"from":1074,"n":81,"old":1167,"oldN":100,"kind":"say","text":"휴대폰을 꺼내서 메모를 열 때까지 적을 내용을 잠깐"},{"from":1155,"n":101,"old":1267,"oldN":109,"kind":"say","text":"머릿속에 담아 둬야 합니다. 그때 쓰는 게 작업 기억입니다."},{"from":1256,"n":77,"old":1376,"oldN":77,"kind":"say","text":"저는 휴대폰을 꺼내는 그 몇 초 사이에도"},{"from":1333,"n":60,"old":1453,"oldN":59,"kind":"say","text":"생각이 사라질 때가 있습니다."},{"from":1393,"n":82,"old":1512,"oldN":106,"kind":"say","text":"잊어버린 걸 나중에 떠올려도 이미 늦을 때가 있습니다."},{"from":1475,"n":113,"old":1618,"oldN":123,"kind":"say","text":"가령 구독을 해지하려던 날을 놓치면 다음 달 요금이 또 나갑니다."},{"from":1588,"n":93,"old":1741,"oldN":124,"kind":"say","text":"이렇게 더 드는 돈을 ‘ADHD 택스’라고 부르기도 합니다."},{"from":1681,"n":70,"old":1865,"oldN":86,"kind":"say","text":"저희 설문에서는 절반 넘는 분이 이런 이유로"},{"from":1751,"n":89,"old":1951,"oldN":87,"kind":"say","text":"한 달에 10만 원 이상을 더 쓴다고 답했습니다."},{"from":1840,"n":68,"old":2038,"oldN":83,"kind":"say","text":"그러면 ‘그냥 메모해두면 되지 않나?’"},{"from":1908,"n":57,"old":2121,"oldN":71,"kind":"say","text":"하는 생각이 드실 수 있습니다."},{"from":1965,"n":22,"old":2192,"oldN":22,"kind":"wait","text":"청중을 본다"},{"from":1987,"n":89,"old":2214,"oldN":82,"kind":"say","text":"저도 그래서 메모 앱을 여러 개 써봤습니다."},{"from":2076,"n":62,"old":2296,"oldN":68,"kind":"say","text":"그런데 적을 게 생각나면, 메모 앱을"},{"from":2138,"n":75,"old":2364,"oldN":82,"kind":"say","text":"열어야 한다는 것부터 기억해야 했습니다."},{"from":2213,"n":65,"old":2446,"oldN":77,"kind":"say","text":"앱을 찾아서 열고 나면 거기에 뭘 쓰려고"},{"from":2278,"n":70,"old":2523,"oldN":68,"kind":"say","text":"했는지 잊어버릴 때가 있었습니다."},{"from":2348,"n":112,"old":2591,"oldN":114,"kind":"say","text":"잊기 전에 적어 놓은 날도 있었습니다. 그런데 앱을 닫고 나면"},{"from":2460,"n":115,"old":2705,"oldN":119,"kind":"say","text":"적어 놨다는 사실까지 잊어서 다시 열어볼 생각을 못 했습니다."},{"from":2575,"n":91,"old":2824,"oldN":100,"kind":"say","text":"저희가 인터뷰한 분들도 비슷한 얘기를 하셨습니다."},{"from":2666,"n":50,"old":2924,"oldN":63,"kind":"say","text":"그래서 이렇게 생각했습니다."},{"from":2716,"n":108,"old":2987,"oldN":113,"kind":"say","text":"‘눈앞에 없으면 잊는데, 처음부터 눈앞에 있으면 어떨까?’"},{"from":2824,"n":48,"old":3100,"oldN":72,"kind":"say","text":"그렇다고 메모장이 하루 종일 화면을"},{"from":2872,"n":70,"old":3172,"oldN":72,"kind":"say","text":"가리면 저부터 꺼버릴 것 같았습니다."},{"from":2942,"n":76,"old":3244,"oldN":86,"kind":"say","text":"혼자서는 미루던 일도 누가 옆에서 자기 일을"},{"from":3018,"n":68,"old":3330,"oldN":77,"kind":"say","text":"하고 있으면 저도 시작할 때가 있습니다."},{"from":3086,"n":55,"old":3407,"oldN":68,"kind":"say","text":"이렇게 누군가와 함께 각자 할 일을"},{"from":3141,"n":72,"old":3475,"oldN":68,"kind":"say","text":"하는 걸 ‘바디 더블링’이라고 합니다."},{"from":3213,"n":125,"old":3543,"oldN":123,"kind":"say","text":"저희는 여기서 힌트를 얻었습니다. 메모장을 계속 띄워 놓는 대신"},{"from":3338,"n":110,"old":3666,"oldN":114,"kind":"say","text":"작은 강아지를 곁에 두고, 필요할 때만 메모를 열게 했습니다."},{"from":3448,"n":86,"old":3780,"oldN":100,"kind":"say","text":"제가 먼저 제 폰에 띄워 써보고, 다른 분들이 써보면서"},{"from":3534,"n":116,"old":3880,"oldN":109,"kind":"say","text":"해주신 얘기를 듣고 고쳤습니다. 직접 보여드리겠습니다."},{"from":3650,"n":113,"old":3989,"oldN":123,"kind":"say","text":"여기가 스티키펫의 첫 화면입니다. 저희는 마당이라고 부릅니다."},{"from":3763,"n":55,"old":4112,"oldN":59,"kind":"say","text":"여기서 강아지랑 놀 수도 있고,"},{"from":3818,"n":74,"old":4171,"oldN":86,"kind":"say","text":"아래쪽에 보이는 메모장을 열 수도 있습니다."},{"from":3892,"n":91,"old":4257,"oldN":91,"kind":"say","text":"여기를 누르면 제가 적어 놓은 메모가 나옵니다."},{"from":3983,"n":63,"old":4348,"oldN":63,"kind":"say","text":"여기까지만 보면 강아지 키우는"},{"from":4046,"n":62,"old":4411,"oldN":68,"kind":"say","text":"앱에 메모장 하나 붙인 것 같습니다."},{"from":4108,"n":89,"old":4479,"oldN":91,"kind":"say","text":"다른 메모 앱과 뭐가 다른지 보여드리겠습니다."},{"from":4197,"n":67,"old":4570,"oldN":63,"kind":"say","text":"제가 한번 앱을 나가보겠습니다."},{"from":4264,"n":32,"old":4633,"oldN":32,"kind":"wait","text":"앱 밖으로 · 손을 뗀다"},{"from":4296,"n":43,"old":4665,"oldN":43,"kind":"wait","text":"강아지가 보일 때까지 기다린다"},{"from":4339,"n":144,"old":4708,"oldN":123,"kind":"say","text":"저는 앱을 나왔는데, 아까 마당에 있던 강아지는 따라 나왔습니다."},{"from":4483,"n":106,"old":4831,"oldN":78,"kind":"say","text":"이제 다른 걸 하다가 적을 게 생기면 메모"},{"from":4589,"n":96,"old":4909,"oldN":77,"kind":"say","text":"앱을 찾지 않고 이 친구를 누르면 됩니다."},{"from":4685,"n":26,"old":4986,"oldN":26,"kind":"wait","text":"펫 누르기"},{"from":4711,"n":96,"old":5012,"oldN":95,"kind":"say","text":"저녁에 장을 봐야 하면 ‘우유, 달걀’만 적으면 됩니다."},{"from":4807,"n":36,"old":5107,"oldN":49,"kind":"say","text":"이걸 어느 목록에 넣을지,"},{"from":4843,"n":77,"old":5156,"oldN":91,"kind":"say","text":"날짜는 언제로 할지 먼저 정하지 않아도 됩니다."},{"from":4920,"n":87,"old":5247,"oldN":91,"kind":"say","text":"저는 생각났을 때 적는 게 먼저였으면 했습니다."},{"from":5007,"n":65,"old":5338,"oldN":68,"kind":"say","text":"마당과 방금 보신 기본 메모는 지금"},{"from":5072,"n":55,"old":5406,"oldN":68,"kind":"say","text":"구글 플레이에서 쓰실 수 있습니다."},{"from":5127,"n":96,"old":5474,"oldN":114,"kind":"say","text":"이제부터는 저희가 같은 폰에서 시험하고 있는 기능입니다."},{"from":5223,"n":96,"old":5588,"oldN":109,"kind":"say","text":"할 일이 여러 개인데 하나씩 타자로 치려면 번거롭습니다."},{"from":5319,"n":78,"old":5697,"oldN":77,"kind":"say","text":"이번엔 생각나는 대로 말해보겠습니다."},{"from":5397,"n":101,"old":5774,"oldN":127,"kind":"say","text":"내일 세 시에 치과 가고, 집에 오는 길에 세탁물 찾아야지."},{"from":5498,"n":71,"old":5901,"oldN":81,"kind":"say","text":"아, 서영이한테 자료도 보내야 돼."},{"from":5569,"n":74,"old":5982,"oldN":72,"kind":"say","text":"방금 저는 할 일을 세 가지 말했습니다."},{"from":5643,"n":90,"old":6054,"oldN":105,"kind":"say","text":"제목을 붙이거나 순서를 정해서 말하지는 않았습니다."},{"from":5733,"n":29,"old":6159,"oldN":29,"kind":"wait","text":"결과가 뜰 때까지 기다린다"},{"from":5762,"n":79,"old":6188,"oldN":82,"kind":"say","text":"치과는 내일 세 시 일정으로, 세탁물 찾기와"},{"from":5841,"n":105,"old":6270,"oldN":105,"kind":"say","text":"서영이한테 자료 보내기는 각각 할 일로 들어갔습니다."},{"from":5946,"n":99,"old":6375,"oldN":105,"kind":"say","text":"그런데 지하철에서 청첩장을 받았다고 해보겠습니다."},{"from":6045,"n":72,"old":6480,"oldN":68,"kind":"say","text":"옆에 사람들이 있는데 예식 날짜와"},{"from":6117,"n":86,"old":6548,"oldN":77,"kind":"say","text":"장소를 소리 내서 읽기는 좀 그렇습니다."},{"from":6203,"n":108,"old":6625,"oldN":86,"kind":"say","text":"이럴 땐 청첩장을 연 채로 화면을 캡처합니다."},{"from":6311,"n":48,"old":6711,"oldN":58,"kind":"wait","text":"캡처하고 기다린다"},{"from":6359,"n":67,"old":6769,"oldN":82,"kind":"say","text":"예식 날짜와 시간, 장소가 같이 나왔습니다."},{"from":6426,"n":44,"old":6851,"oldN":49,"kind":"say","text":"이대로 저장하겠습니다."},{"from":6470,"n":82,"old":6900,"oldN":91,"kind":"say","text":"메모를 적는 것만큼 다시 찾는 것도 중요합니다."},{"from":6552,"n":79,"old":6991,"oldN":72,"kind":"say","text":"아까 저는 ‘치과’라고 했는데, 나중에는"},{"from":6631,"n":82,"old":7063,"oldN":77,"kind":"say","text":"‘병원 언제 가더라?’만 생각날 수 있습니다."},{"from":6713,"n":84,"old":7140,"oldN":72,"kind":"say","text":"이번에는 병원으로 찾아보겠습니다."},{"from":6797,"n":24,"old":7212,"oldN":24,"kind":"wait","text":"검색 결과를 보여준다"},{"from":6821,"n":101,"old":7236,"oldN":107,"kind":"say","text":"‘병원’이라고 쳤는데 아까 말한 치과 예약이 나옵니다."},{"from":6922,"n":111,"old":7343,"oldN":126,"kind":"say","text":"제가 적을 때 어떤 단어를 썼는지까지 기억하지 않아도 됩니다."},{"from":7033,"n":58,"old":7469,"oldN":72,"kind":"say","text":"지금까지는 제가 ‘이거 적어야겠다’고"},{"from":7091,"n":62,"old":7541,"oldN":72,"kind":"say","text":"생각하고 먼저 강아지를 눌렀습니다."},{"from":7153,"n":108,"old":7613,"oldN":123,"kind":"say","text":"그런데 저는 적어야 한다는 생각도 못 하고 지나칠 때가 있습니다."},{"from":7261,"n":75,"old":7736,"oldN":77,"kind":"say","text":"강아지는 그때도 제 화면에 떠 있습니다."},{"from":7336,"n":119,"old":7813,"oldN":119,"kind":"say","text":"제가 누르기 전에 먼저 적어둘지 물어보면 어떨까 싶었습니다."},{"from":7455,"n":124,"old":7932,"oldN":127,"kind":"say","text":"그래서 실제 폰에서 한번 해보려고 만든 게 이 자동 추천입니다."},{"from":7579,"n":84,"old":8059,"oldN":65,"kind":"say","text":"아직 출시한 기능은 아닙니다."},{"from":7663,"n":69,"old":8124,"oldN":89,"kind":"say","text":"같은 폰에서 시제품을 보여드리겠습니다."},{"from":7732,"n":41,"old":8213,"oldN":41,"kind":"wait","text":"자동 추천 켜기"},{"from":7773,"n":110,"old":8254,"oldN":109,"kind":"say","text":"저는 서울에 갈 때 버스나 KTX 표를 자주 끊습니다."},{"from":7883,"n":92,"old":8363,"oldN":95,"kind":"say","text":"여기 서울행 KTX 표를 하나 준비했습니다."},{"from":7975,"n":101,"old":8458,"oldN":95,"kind":"say","text":"예매는 했지만 출발 시간은 또 따로 챙겨야 합니다."},{"from":8076,"n":96,"old":8553,"oldN":100,"kind":"say","text":"메모를 열지도 않았는데 강아지가 먼저 아홉 시 이십"},{"from":8172,"n":110,"old":8653,"oldN":100,"kind":"say","text":"분 열차를 적어둘지 물어봅니다. 저장해보겠습니다."},{"from":8282,"n":38,"old":8753,"oldN":38,"kind":"wait","text":"저장된 출발 시간 확인"},{"from":8320,"n":95,"old":8791,"oldN":100,"kind":"say","text":"이번에는 시연용으로 준비한 발표 공지 메일입니다."},{"from":8415,"n":127,"old":8891,"oldN":119,"kind":"say","text":"발표는 금요일 오후 두 시입니다. 이 시간만 저장해 두겠습니다."},{"from":8542,"n":24,"old":9010,"oldN":24,"kind":"wait","text":"저장 완료"},{"from":8566,"n":84,"old":9034,"oldN":91,"kind":"say","text":"이번엔 친구가 카톡으로 저녁을 먹자고 합니다."},{"from":8650,"n":67,"old":9125,"oldN":63,"kind":"say","text":"제가 ‘좋아’라고 답해보겠습니다."},{"from":8717,"n":29,"old":9188,"oldN":29,"kind":"wait","text":"좋아 · 전송"},{"from":8746,"n":84,"old":9217,"oldN":86,"kind":"say","text":"제가 답장을 보내고 나니까, 강아지가 금요일"},{"from":8830,"n":75,"old":9303,"oldN":82,"kind":"say","text":"저녁 여섯 시 약속을 적어둘지 물어봅니다."},{"from":8905,"n":89,"old":9385,"oldN":97,"kind":"say","text":"이번에는 카톡으로 이런 질문이 왔습니다."},{"from":8994,"n":41,"old":9482,"oldN":55,"kind":"say","text":"‘우리 발표 몇 시였지?’"},{"from":9035,"n":68,"old":9537,"oldN":72,"kind":"say","text":"평소라면 여기서 카톡을 나가서 아까"},{"from":9103,"n":66,"old":9609,"oldN":72,"kind":"say","text":"그 메일을 찾아보고 돌아왔을 겁니다."},{"from":9169,"n":31,"old":9681,"oldN":31,"kind":"wait","text":"펫이 먼저 시간을 꺼낼 때까지"},{"from":9200,"n":70,"old":9712,"oldN":86,"kind":"say","text":"금요일 두 시입니다. 아까 제가 메일을 보면서"},{"from":9270,"n":89,"old":9798,"oldN":82,"kind":"say","text":"저장한 발표 시간이 카톡에 바로 떴습니다."},{"from":9359,"n":111,"old":9880,"oldN":114,"kind":"say","text":"메일을 다시 열지 않고 여기서 바로 답장을 보낼 수 있습니다."},{"from":9470,"n":124,"old":9994,"oldN":123,"kind":"say","text":"처음 마당에서 보셨을 때는 그냥 귀여운 강아지 한 마리였습니다."},{"from":9594,"n":93,"old":10117,"oldN":95,"kind":"say","text":"그런데 방금은 제가 발표 시간을 잊어도 이 친구가"},{"from":9687,"n":101,"old":10212,"oldN":100,"kind":"say","text":"기억하고 있어서, 메일을 다시 찾지 않아도 됐습니다."},{"from":9788,"n":50,"old":10312,"oldN":63,"kind":"say","text":"저희가 만들고 싶은 건 필요할 때"},{"from":9838,"n":68,"old":10375,"oldN":72,"kind":"say","text":"이렇게 옆에서 알려주는 친구입니다."},{"from":9906,"n":80,"old":10447,"oldN":89,"kind":"say","text":"방금 보신 자동 추천은 아직 시제품입니다."},{"from":9986,"n":123,"old":10536,"oldN":123,"kind":"say","text":"그럼 사람들이 지금 출시한 앱을 얼마나 쓰는지 보겠습니다."},{"from":10109,"n":48,"old":10659,"oldN":72,"kind":"say","text":"구글 플레이에서 스티키펫을 받을 수"},{"from":10157,"n":85,"old":10731,"oldN":77,"kind":"say","text":"있는 곳은 22개 국가와 지역입니다."},{"from":10242,"n":82,"old":10808,"oldN":82,"kind":"say","text":"출시하고 한 달쯤 지났을 때 7,700명이"},{"from":10324,"n":75,"old":10890,"oldN":72,"kind":"say","text":"넘는 분이 스티키펫을 써주셨습니다."},{"from":10399,"n":96,"old":10962,"oldN":95,"kind":"say","text":"강아지가 귀여워서 한 번쯤 받아볼 수는 있습니다."},{"from":10495,"n":67,"old":11057,"oldN":82,"kind":"say","text":"그런데 저희는 설치한 뒤에도 메모할 일이"},{"from":10562,"n":82,"old":11139,"oldN":72,"kind":"say","text":"생기면 이 친구를 찾았으면 했습니다."},{"from":10644,"n":45,"old":11211,"oldN":59,"kind":"say","text":"‘일주일 뒤에도 이 친구를 다시"},{"from":10689,"n":87,"old":11270,"oldN":72,"kind":"say","text":"찾을까?’ 저희는 그게 더 궁금했습니다."},{"from":10776,"n":69,"old":11342,"oldN":77,"kind":"say","text":"처음 쓴 날에서 딱 일주일 뒤에 앱을 다시"},{"from":10845,"n":87,"old":11419,"oldN":86,"kind":"say","text":"열거나 메모를 보거나 고친 기록을 셌습니다."},{"from":10932,"n":93,"old":11505,"oldN":86,"kind":"say","text":"설치 기준으로 23.5%였습니다."},{"from":11025,"n":22,"old":11591,"oldN":43,"kind":"wait","text":"숫자를 보여주고 한 박자 쉰다"},{"from":11047,"n":70,"old":11634,"oldN":82,"kind":"say","text":"강아지가 화면에 떠 있기만 한 경우는 빼고,"},{"from":11117,"n":86,"old":11716,"oldN":72,"kind":"say","text":"실제로 다시 썼을 때만 센 숫자입니다."},{"from":11203,"n":53,"old":11788,"oldN":72,"kind":"say","text":"그런데 사용 기록만 봐서는 사람들이"},{"from":11256,"n":82,"old":11860,"oldN":72,"kind":"say","text":"왜 다시 왔는지까지는 알 수 없습니다."},{"from":11338,"n":142,"old":11932,"oldN":146,"kind":"say","text":"중간평가 때 이런 말씀을 들었습니다. ADHD가 아니어도 평소에 잘"},{"from":11480,"n":110,"old":12078,"oldN":128,"kind":"say","text":"잊어버리는 분이라면 이 앱이 필요하지 않겠냐는 말씀이었습니다."},{"from":11590,"n":120,"old":12206,"oldN":137,"kind":"say","text":"저희는 광고에서 ADHD를 앞세우지 않았습니다. 그래서 어떤"},{"from":11710,"n":125,"old":12343,"oldN":114,"kind":"say","text":"분들이 스티키펫을 찾아왔는지 직접 여쭤보고 싶었습니다."},{"from":11835,"n":96,"old":12457,"oldN":117,"kind":"say","text":"그래서 앱 안 우편함으로 저희가 먼저 편지를 보냈습니다."},{"from":11931,"n":103,"old":12574,"oldN":112,"kind":"say","text":"평소에 스티키펫을 어떻게 쓰고 계신지 여쭤봤습니다."},{"from":12034,"n":82,"old":12686,"oldN":88,"kind":"say","text":"그렇게 받은 답장이 300건 정도였습니다."},{"from":12116,"n":55,"old":12774,"oldN":55,"kind":"wait","text":"답장 한 통을 읽는 시간"},{"from":12171,"n":70,"old":12829,"oldN":82,"kind":"say","text":"이분은 평소에 자주 깜빡해서 스티키펫을"},{"from":12241,"n":72,"old":12911,"oldN":77,"kind":"say","text":"한번 써보려고 한다고 적어주셨습니다."},{"from":12313,"n":101,"old":12988,"oldN":119,"kind":"say","text":"브라질에서 답장을 주신 분은 심리교육 일을 하신다고 합니다."},{"from":12414,"n":75,"old":13107,"oldN":77,"kind":"say","text":"본인뿐 아니라 그 일로 만나는 분들께도"},{"from":12489,"n":64,"old":13184,"oldN":63,"kind":"say","text":"도움이 됐다고 적어주셨습니다."},{"from":12553,"n":82,"old":13247,"oldN":100,"kind":"say","text":"답장에 본인이 ADHD라고 직접 적어주신"},{"from":12635,"n":53,"old":13347,"oldN":59,"kind":"say","text":"분도 스물여섯 분 있었습니다."},{"from":12688,"n":89,"old":13406,"oldN":95,"kind":"say","text":"그분들이 스티키펫을 얼마나 쓰는지 따로 봤더니,"},{"from":12777,"n":111,"old":13501,"oldN":119,"kind":"say","text":"스물여섯 분 중 열두 분이 사용량 상위 10%에 들었습니다."},{"from":12888,"n":111,"old":13620,"oldN":147,"kind":"say","text":"처음에 저는 제가 계속 쓸 앱을 만들고 싶었다고 말씀드렸습니다."},{"from":12999,"n":57,"old":13767,"oldN":82,"kind":"say","text":"저는 이제 메모를 어디에 적어 뒀는지"},{"from":13056,"n":80,"old":13849,"oldN":101,"kind":"say","text":"찾아다니던 때로 돌아가고 싶지 않습니다."},{"from":13136,"n":88,"old":13950,"oldN":123,"kind":"say","text":"그런데 우편함을 열어보니 저처럼 자꾸 깜빡해서 이 앱을"},{"from":13224,"n":119,"old":14073,"oldN":126,"kind":"say","text":"찾아온 분들이 계셨습니다. 저는 그게 참 반가웠습니다."},{"from":13343,"n":93,"old":14199,"oldN":145,"kind":"say","text":"이제 저희 팀장 김서영 님께 마이크를 넘기겠습니다."},{"from":13436,"n":38,"old":14344,"oldN":60,"kind":"wait","text":"서영님에게 마이크를 넘긴다"}],"interview":[{"at":0,"text":"그냥 반짝하고 없어지는 것 같아요"},{"at":52,"text":"떠올랐다가 그런 생각을 했던 것도 까먹을 만큼"},{"at":159,"text":"까먹었다는 사실도 잊을 만큼"},{"at":204,"text":"그냥 완전 없는 기억이 되는 것 같아요"}]}